{
  "manifestVersion": 4,
  "id": "com.hanleyai.vtkspiritwallbuilder",
  "name": "VTK Spirit Wall Builder",
  "version": "3.2.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "stepRepeatPanel",
      "label": {
        "default": "VTK Spirit Wall Builder"
      },
      "minimumSize":          { "width": 880, "height": 300 },
      "maximumSize":          { "width": 880, "height": 2000 },
      "preferredDockedSize":  { "width": 880, "height": 650 },
      "preferredFloatingSize":{ "width": 880, "height": 650 }
    }
  ]
}
